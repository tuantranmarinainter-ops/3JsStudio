{
  "enabledPlugins": {
    "hyperframes@hyperframes": false
  },
  "permissions": {
    "deny": [
      "Bash(git stash:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git checkout .:*)",
      "Bash(git restore .:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git reset --hard:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git checkout -- .:*)",
      "PowerShell(git checkout .:*)",
      "PowerShell(git restore .:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ],
    "ask": [
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(Remove-Item -Recurse:*)"
    ]
  }
}
