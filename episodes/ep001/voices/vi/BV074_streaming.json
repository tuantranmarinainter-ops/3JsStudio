{
 "dry": false,
 "total": 171.362,
 "lines": [
  {
   "line": 1,
   "who": "narrator",
   "text": "Trong thế giới này, mỗi đêm có một ngôi nhà ngẫu nhiên trong thị trấn biến mất, rồi thức dậy ở một nơi khác trên thế giới.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 0.0,
   "start": 0.0,
   "end": 4.782,
   "dur": 4.782
  },
  {
   "line": 2,
   "who": "narrator",
   "text": "Bạn thấy đấy, vào lúc nửa đêm, những chiếc chân gỗ khổng lồ vươn ra từ tầng hầm.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 4.88,
   "start": 4.881,
   "end": 8.513,
   "dur": 3.632
  },
  {
   "line": 3,
   "who": "narrator",
   "text": "Ngôi nhà đứng dậy, rũ sạch đất cát, rồi bước đi khi cả gia đình vẫn đang say ngủ bên trong.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 8.61,
   "start": 8.611,
   "end": 12.941,
   "dur": 4.33
  },
  {
   "line": 4,
   "who": "narrator",
   "text": "Đến sáng, nó có thể ở bất cứ đâu, một bãi biển Hawaii, một khu rừng rậm Brazil, hay giữa sa mạc Sahara.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 13.04,
   "start": 13.041,
   "end": 18.183,
   "dur": 5.143
  },
  {
   "line": 5,
   "who": "narrator",
   "text": "Bạn có một ngày để khám phá, và đến đêm tiếp theo, nó sẽ đưa bạn đi bộ về nhà.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 18.28,
   "start": 18.281,
   "end": 22.291,
   "dur": 4.01
  },
  {
   "line": 6,
   "who": "narrator",
   "text": "Suốt 100 năm qua, chưa có nhà nào một đi không trở lại cho đến lượt nhà chúng tôi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 22.39,
   "start": 22.39,
   "end": 26.479,
   "dur": 4.089
  },
  {
   "line": 7,
   "who": "narrator",
   "text": "Khi ấy, chỉ có tôi và mẹ.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 26.58,
   "start": 26.581,
   "end": 27.989,
   "dur": 1.408
  },
  {
   "line": 8,
   "who": "narrator",
   "text": "Ba tôi là một nhà thám hiểm.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 28.08,
   "start": 28.081,
   "end": 29.403,
   "dur": 1.322
  },
  {
   "line": 9,
   "who": "narrator",
   "text": "Ông đi khắp thế giới và đặt chân đến đâu, ông cũng gửi về một tấm bưu thiếp.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 29.5,
   "start": 29.501,
   "end": 32.733,
   "dur": 3.232
  },
  {
   "line": 10,
   "who": "narrator",
   "text": "Chúng tôi giữ tất cả trên cửa tủ lạnh.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 32.83,
   "start": 32.831,
   "end": 34.472,
   "dur": 1.641
  },
  {
   "line": 11,
   "who": "narrator",
   "text": "Ba năm trước, những tấm bưu thiếp ngừng gửi về.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 34.57,
   "start": 34.57,
   "end": 36.535,
   "dur": 1.964
  },
  {
   "line": 12,
   "who": "narrator",
   "text": "Con tàu của ông không bao giờ quay lại, và mẹ tôi cũng thôi nhìn vào tủ lạnh.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 36.63,
   "start": 36.631,
   "end": 40.109,
   "dur": 3.479
  },
  {
   "line": 13,
   "who": "narrator",
   "text": "Rồi một đêm nọ, ngôi nhà của chúng tôi thức giấc.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 40.21,
   "start": 40.211,
   "end": 42.282,
   "dur": 2.071
  },
  {
   "line": 14,
   "who": "narrator",
   "text": "Cả sàn nhà nghiêng đi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 42.38,
   "start": 42.381,
   "end": 43.434,
   "dur": 1.053
  },
  {
   "line": 15,
   "who": "narrator",
   "text": "Tôi chạy ra cửa sổ và thấy nhà mình đang đứng trên bốn chiếc chân khổng lồ, sải bước xuống phố.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 43.53,
   "start": 43.531,
   "end": 47.72,
   "dur": 4.19
  },
  {
   "line": 16,
   "who": "narrator",
   "text": "Rầm, rầm, rầm.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 47.82,
   "start": 47.821,
   "end": 48.956,
   "dur": 1.135
  },
  {
   "line": 17,
   "who": "narrator",
   "text": "Nó bước ra khỏi thị trấn, băng qua khu rừng, rồi tiến vào bóng tối.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 48.85,
   "start": 48.956,
   "end": 52.38,
   "dur": 3.424
  },
  {
   "line": 18,
   "who": "narrator",
   "text": "Sáng hôm sau, tôi mở cửa ra và hơi băng giá thổi tạt vào mặt.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 52.48,
   "start": 52.481,
   "end": 55.453,
   "dur": 2.972
  },
  {
   "line": 19,
   "who": "narrator",
   "text": "Những chú chim cánh cụt lạch bạch đi qua hộp thư nhà tôi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 55.55,
   "start": 55.55,
   "end": 57.992,
   "dur": 2.441
  },
  {
   "line": 20,
   "who": "narrator",
   "text": "Nam Cực.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 58.09,
   "start": 58.09,
   "end": 58.593,
   "dur": 0.503
  },
  {
   "line": 21,
   "who": "narrator",
   "text": "Nhưng đêm đó, ngôi nhà không đi về, mà lại đến một nơi khác.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 58.59,
   "start": 58.593,
   "end": 61.663,
   "dur": 3.069
  },
  {
   "line": 22,
   "who": "narrator",
   "text": "Sáng hôm sau là nước.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 61.76,
   "start": 61.76,
   "end": 62.724,
   "dur": 0.963
  },
  {
   "line": 23,
   "who": "narrator",
   "text": "Ngôi nhà đang đứng ngập đến ngang lưng giữa đại dương, với những chú cá voi bơi quanh chân nó.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 62.79,
   "start": 62.79,
   "end": 66.831,
   "dur": 4.041
  },
  {
   "line": 24,
   "who": "narrator",
   "text": "Và sáng hôm sau nữa, chúng tôi đã ở trên đỉnh núi, với biển mây ngay dưới hiên nhà.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 66.93,
   "start": 66.931,
   "end": 70.654,
   "dur": 3.723
  },
  {
   "line": 25,
   "who": "narrator",
   "text": "Mẹ tôi bắt đầu hoảng loạn.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 70.75,
   "start": 70.751,
   "end": 71.837,
   "dur": 1.086
  },
  {
   "line": 26,
   "who": "narrator",
   "text": "Các ngôi nhà luôn quay về cơ mà.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 71.93,
   "start": 71.93,
   "end": 73.323,
   "dur": 1.393
  },
  {
   "line": 27,
   "who": "narrator",
   "text": "Tại sao nó không về nhà?",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 73.36,
   "start": 73.361,
   "end": 74.542,
   "dur": 1.181
  },
  {
   "line": 28,
   "who": "narrator",
   "text": "Tôi vào bếp lấy nước, rồi sững lại ngay trước những tấm bưu thiếp.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 74.64,
   "start": 74.64,
   "end": 77.413,
   "dur": 2.772
  },
  {
   "line": 29,
   "who": "narrator",
   "text": "Tấm đầu tiên có hình chim cánh cụt.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 77.51,
   "start": 77.511,
   "end": 79.034,
   "dur": 1.523
  },
  {
   "line": 30,
   "who": "narrator",
   "text": "Lời chào từ Nam Cực.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 79.13,
   "start": 79.131,
   "end": 80.221,
   "dur": 1.091
  },
  {
   "line": 31,
   "who": "narrator",
   "text": "Tấm thứ hai có hình cá voi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 80.32,
   "start": 80.321,
   "end": 81.682,
   "dur": 1.361
  },
  {
   "line": 32,
   "who": "narrator",
   "text": "Giữa Thái Bình Dương.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 81.78,
   "start": 81.781,
   "end": 82.726,
   "dur": 0.945
  },
  {
   "line": 33,
   "who": "narrator",
   "text": "Thấy một chú cá voi ngay dưới thuyền.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 82.82,
   "start": 82.821,
   "end": 84.333,
   "dur": 1.512
  },
  {
   "line": 34,
   "who": "narrator",
   "text": "Tấm thứ ba là ngọn núi trên tầng mây.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 84.43,
   "start": 84.431,
   "end": 86.201,
   "dur": 1.771
  },
  {
   "line": 35,
   "who": "narrator",
   "text": "Đỉnh của thế giới.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 86.3,
   "start": 86.301,
   "end": 87.329,
   "dur": 1.028
  },
  {
   "line": 36,
   "who": "narrator",
   "text": "Ước gì hai mẹ con ở đây.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 87.43,
   "start": 87.431,
   "end": 88.667,
   "dur": 1.236
  },
  {
   "line": 37,
   "who": "narrator",
   "text": "Tim tôi đập thình thịch.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 88.76,
   "start": 88.761,
   "end": 89.889,
   "dur": 1.129
  },
  {
   "line": 38,
   "who": "narrator",
   "text": "Mẹ ơi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 90.02,
   "start": 90.021,
   "end": 90.555,
   "dur": 0.534
  },
  {
   "line": 39,
   "who": "narrator",
   "text": "Mẹ bước vào.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 90.36,
   "start": 90.555,
   "end": 91.3,
   "dur": 0.745
  },
  {
   "line": 40,
   "who": "narrator",
   "text": "Tôi chỉ vào tủ lạnh, rồi chỉ ra ngoài cửa sổ.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 91.13,
   "start": 91.3,
   "end": 93.445,
   "dur": 2.144
  },
  {
   "line": 41,
   "who": "narrator",
   "text": "Mọi nơi ngôi nhà dừng chân đều là nơi ba đã gửi bưu thiếp theo đúng thứ tự đó.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 93.54,
   "start": 93.54,
   "end": 97.213,
   "dur": 3.673
  },
  {
   "line": 42,
   "who": "narrator",
   "text": "Ngôi nhà không hề bị lạc.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 97.43,
   "start": 97.431,
   "end": 98.557,
   "dur": 1.126
  },
  {
   "line": 43,
   "who": "narrator",
   "text": "Nó đang lần theo dấu vết của ba.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 98.65,
   "start": 98.65,
   "end": 100.152,
   "dur": 1.502
  },
  {
   "line": 44,
   "who": "narrator",
   "text": "Nó đang đi tìm ông.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 100.25,
   "start": 100.251,
   "end": 101.245,
   "dur": 0.994
  },
  {
   "line": 45,
   "who": "narrator",
   "text": "Mẹ nhìn chằm chằm vào tủ lạnh, rồi gỡ tấm bưu thiếp cuối cùng xuống.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 101.34,
   "start": 101.341,
   "end": 104.391,
   "dur": 3.05
  },
  {
   "line": 46,
   "who": "narrator",
   "text": "Đó là tấm gửi về từ ba năm trước, ngay trước khi ông mất tích.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 104.49,
   "start": 104.491,
   "end": 106.903,
   "dur": 2.413
  },
  {
   "line": 47,
   "who": "narrator",
   "text": "Một hòn đảo nhỏ xíu và một ngọn hải đăng nhỏ.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 107.0,
   "start": 107.001,
   "end": 108.962,
   "dur": 1.961
  },
  {
   "line": 48,
   "who": "narrator",
   "text": "Đã tìm thấy một thứ tuyệt vời.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 109.06,
   "start": 109.061,
   "end": 110.354,
   "dur": 1.294
  },
  {
   "line": 49,
   "who": "narrator",
   "text": "Sẽ sớm về nhà thôi.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 110.45,
   "start": 110.451,
   "end": 111.513,
   "dur": 1.062
  },
  {
   "line": 50,
   "who": "narrator",
   "text": "Yêu cả hai mẹ con.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 111.61,
   "start": 111.61,
   "end": 112.589,
   "dur": 0.979
  },
  {
   "line": 51,
   "who": "narrator",
   "text": "Đêm đó, ngôi nhà lại đứng dậy.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 112.66,
   "start": 112.661,
   "end": 114.422,
   "dur": 1.761
  },
  {
   "line": 52,
   "who": "narrator",
   "text": "Nó đi bộ suốt nhiều giờ liền, băng qua biển đóng băng, vượt qua một cơn bão, rồi cuối cùng cũng dừng lại.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 114.52,
   "start": 114.521,
   "end": 119.442,
   "dur": 4.921
  },
  {
   "line": 53,
   "who": "narrator",
   "text": "Trời sáng, tôi mở cửa trước, cát, những hàng cây cọ, những con sóng và một ngọn hải đăng nhỏ nằm ở rìa một hòn đảo tí hon.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 119.54,
   "start": 119.54,
   "end": 125.593,
   "dur": 6.053
  },
  {
   "line": 54,
   "who": "narrator",
   "text": "Chính là nơi trong tấm bưu thiếp.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 125.69,
   "start": 125.691,
   "end": 126.917,
   "dur": 1.226
  },
  {
   "line": 55,
   "who": "narrator",
   "text": "Và ngồi trên mỏm đá dưới chân hải đăng là một người đàn ông râu dài, mặc chiếc áo khoác rách, tay cầm một xấp bưu thiếp không bao giờ gửi đi được.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 127.01,
   "start": 127.011,
   "end": 133.18,
   "dur": 6.169
  },
  {
   "line": 56,
   "who": "narrator",
   "text": "Ông ngước nhìn lên ngôi nhà đang đứng trên bãi biển bằng bốn chiếc chân khổng lồ, rồi đánh rơi cả xấp bưu thiếp.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 133.28,
   "start": 133.281,
   "end": 138.149,
   "dur": 4.868
  },
  {
   "line": 57,
   "who": "narrator",
   "text": "Ba!",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 138.25,
   "start": 138.251,
   "end": 138.714,
   "dur": 0.464
  },
  {
   "line": 58,
   "who": "narrator",
   "text": "Tôi chạy băng qua bãi cát, mẹ chạy ngay phía sau và chúng tôi lao vào ôm chầm lấy ông mạnh đến mức cả ba ngã nhào xuống cát.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 138.47,
   "start": 138.714,
   "end": 144.403,
   "dur": 5.689
  },
  {
   "line": 59,
   "who": "narrator",
   "text": "Tàu của ông đã đắm ở bãi đá ngầm.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 144.49,
   "start": 144.491,
   "end": 146.112,
   "dur": 1.621
  },
  {
   "line": 60,
   "who": "narrator",
   "text": "Suốt ba năm, ông bị mắc kẹt trên đảo và vẫn viết bưu thiếp mỗi ngày.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 146.21,
   "start": 146.211,
   "end": 149.621,
   "dur": 3.41
  },
  {
   "line": 61,
   "who": "narrator",
   "text": "Và rồi, ngôi nhà đã làm một điều tôi chưa thấy nhà nào làm.",
   "source": "capcut",
   "voice": "BV074_streaming",
   "at": 149.72,
   "start": 149.72,
   "end": 152.283,
   "dur": 2.563
  },
  {
   "line": 62,
   "who": "narrator",
   "text": "Nó gập những chiếc chân khổng lồ lại và khuỵu xuống để ba có thể bước thẳng lên hiên nhà.",
   "source": "capcut",
