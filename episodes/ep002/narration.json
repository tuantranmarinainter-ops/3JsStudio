{
 "dry": false,
 "total": 123.292,
 "lines": [
  {
   "line": 1,
   "who": "narrator",
   "text": "Ở thị trấn này, đồ đạc liên tục biến mất, dù căn phòng đã được khóa kín.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 0.0,
   "end": 3.539,
   "dur": 3.539
  },
  {
   "line": 2,
   "who": "narrator",
   "text": "Ban đầu là két tiền của chú bán bánh.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 3.72,
   "end": 5.369,
   "dur": 1.649
  },
  {
   "line": 3,
   "who": "narrator",
   "text": "Rồi tới nhẫn cưới của cô thợ may.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 5.549,
   "end": 7.107,
   "dur": 1.558
  },
  {
   "line": 4,
   "who": "narrator",
   "text": "Ngay cả ông Bách, người hàng xóm thân thiện hay phát gấu bông miễn phí cho cả thị trấn, cũng báo mất đồ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 7.288,
   "end": 11.952,
   "dur": 4.664
  },
  {
   "line": 5,
   "who": "narrator",
   "text": "Nhà ông còn báo mất nhiều nhất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 12.133,
   "end": 13.424,
   "dur": 1.292
  },
  {
   "line": 6,
   "who": "narrator",
   "text": "Chỉ trong một tuần, cả thị trấn đã có hàng chục nhà báo mất đồ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 13.605,
   "end": 16.538,
   "dur": 2.934
  },
  {
   "line": 7,
   "who": "narrator",
   "text": "Còn tôi là Gà.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 16.719,
   "end": 17.527,
   "dur": 0.808
  },
  {
   "line": 8,
   "who": "narrator",
   "text": "Nhà tôi sát tiệm ông Bách.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 17.708,
   "end": 18.785,
   "dur": 1.077
  },
  {
   "line": 9,
   "who": "narrator",
   "text": "Rồi một sáng, chiếc dây chuyền bà để lại cũng biến mất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 18.966,
   "end": 21.386,
   "dur": 2.42
  },
  {
   "line": 10,
   "who": "narrator",
   "text": "Đó là món tôi quý nhất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 21.567,
   "end": 22.63,
   "dur": 1.063
  },
  {
   "line": 11,
   "who": "narrator",
   "text": "Tôi quyết điều tra vụ mất cắp này.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 22.811,
   "end": 24.25,
   "dur": 1.439
  },
  {
   "line": 12,
   "who": "narrator",
   "text": "Tối đó, tôi đặt cái đồng hồ lên chỗ sợi dây chuyền rồi giả vờ ngủ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 24.651,
   "end": 27.82,
   "dur": 3.169
  },
  {
   "line": 13,
   "who": "narrator",
   "text": "Qua tấm gương đối diện giường, tôi vẫn thấy rõ cái kệ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 28.001,
   "end": 30.459,
   "dur": 2.458
  },
  {
   "line": 14,
   "who": "narrator",
   "text": "Đợi tới lúc tôi sắp ngủ thật, trong gương có thứ gì đó ngồi dậy.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 30.639,
   "end": 33.42,
   "dur": 2.781
  },
  {
   "line": 15,
   "who": "narrator",
   "text": "Là Bắp.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 33.601,
   "end": 33.98,
   "dur": 0.379
  },
  {
   "line": 16,
   "who": "narrator",
   "text": "Con gấu bông vẫn nằm ở cuối giường tôi.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 34.16,
   "end": 35.863,
   "dur": 1.702
  },
  {
   "line": 17,
   "who": "narrator",
   "text": "Nó trèo lên kệ, ôm cái đồng hồ rồi kéo cuốn sách che đúng chỗ vừa lấy đồ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 36.043,
   "end": 39.599,
   "dur": 3.555
  },
  {
   "line": 18,
   "who": "narrator",
   "text": "Tôi bật dậy.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 39.78,
   "end": 40.321,
   "dur": 0.542
  },
  {
   "line": 19,
   "who": "narrator",
   "text": "Bắp biến mất ngay trước mắt.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 40.502,
   "end": 41.608,
   "dur": 1.106
  },
  {
   "line": 20,
   "who": "narrator",
   "text": "Tới lúc tôi mở được cửa sổ, ngoài đường chẳng còn thấy bóng nó đâu.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 41.789,
   "end": 44.765,
   "dur": 2.977
  },
  {
   "line": 21,
   "who": "narrator",
   "text": "Tối hôm sau, tôi đặt một chiếc nhẫn lên kệ.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 45.166,
   "end": 47.218,
   "dur": 2.052
  },
  {
   "line": 22,
   "who": "narrator",
   "text": "Lần này, tôi nấp sẵn ngoài ban công.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 47.399,
   "end": 49.285,
   "dur": 1.886
  },
  {
   "line": 23,
   "who": "narrator",
   "text": "Bắp chộp chiếc nhẫn rồi biến mất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 49.465,
   "end": 50.733,
   "dur": 1.268
  },
  {
   "line": 24,
   "who": "narrator",
   "text": "Từ ban công, tôi thấy nó xuất hiện trên mái hiên nhà đối diện.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 50.914,
   "end": 53.659,
   "dur": 2.745
  },
  {
   "line": 25,
   "who": "narrator",
   "text": "Tôi chạy xuống đường bám theo.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 53.84,
   "end": 55.061,
   "dur": 1.221
  },
  {
   "line": 26,
   "who": "narrator",
   "text": "Qua ngã ba, hai con gấu khác nhập vào.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 55.242,
   "end": 57.196,
   "dur": 1.955
  },
  {
   "line": 27,
   "who": "narrator",
   "text": "Một con ôm ví, một con kéo theo túi tiền.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 57.377,
   "end": 59.569,
   "dur": 2.192
  },
  {
   "line": 28,
   "who": "narrator",
   "text": "Cả ba biến mất sau hàng rào của một nhà máy cuối phố.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 59.749,
   "end": 62.176,
   "dur": 2.427
  },
  {
   "line": 29,
   "who": "narrator",
   "text": "Tôi đứng lên thùng gỗ, ghé mắt qua cửa kính.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 62.577,
   "end": 64.786,
   "dur": 2.209
  },
  {
   "line": 30,
   "who": "narrator",
   "text": "Bắp thả chiếc nhẫn xuống băng chuyền.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 64.966,
   "end": 66.4,
   "dur": 1.434
  },
  {
   "line": 31,
   "who": "narrator",
   "text": "Đứng cuối băng, gom đồ vào thùng, là ông Bách.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 66.581,
   "end": 69.011,
   "dur": 2.43
  },
  {
   "line": 32,
   "who": "narrator",
   "text": "Sau lưng ông là cả một dãy gấu mới may xong.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 69.192,
   "end": 71.279,
   "dur": 2.087
  },
  {
   "line": 33,
   "who": "narrator",
   "text": "Ông chỉ vào tấm bản đồ trên tường.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 71.459,
   "end": 72.974,
   "dur": 1.514
  },
  {
   "line": 34,
   "who": "narrator",
   "text": "Nhà nào có gấu rồi thì đánh dấu.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 73.155,
   "end": 74.729,
   "dur": 1.575
  },
  {
   "line": 35,
   "who": "narrator",
   "text": "Mai phát tiếp mấy nhà còn lại.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 74.91,
   "end": 76.229,
   "dur": 1.319
  },
  {
   "line": 36,
   "who": "narrator",
   "text": "Dưới băng chuyền là két tiền của chú bán bánh.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 76.41,
   "end": 78.266,
   "dur": 1.856
  },
  {
   "line": 37,
   "who": "narrator",
   "text": "Trên nắp két, tôi thấy sợi dây chuyền của bà.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 78.447,
   "end": 80.575,
   "dur": 2.128
  },
  {
   "line": 38,
   "who": "narrator",
   "text": "Tôi chạy thẳng tới nhà thị trưởng.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 80.756,
   "end": 82.095,
   "dur": 1.339
  },
  {
   "line": 39,
   "who": "narrator",
   "text": "Tôi bảo thị trưởng: Chú qua nhìn một lần thôi!",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 82.495,
   "end": 84.732,
   "dur": 2.237
  },
  {
   "line": 40,
   "who": "narrator",
   "text": "Chú lắc đầu.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 84.913,
   "end": 85.556,
   "dur": 0.643
  },
  {
   "line": 41,
   "who": "narrator",
   "text": "Báo đời báo đốm.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 85.737,
   "end": 86.598,
   "dur": 0.862
  },
  {
   "line": 42,
   "who": "narrator",
   "text": "Về ngủ đi!",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 86.779,
   "end": 87.471,
   "dur": 0.692
  },
  {
   "line": 43,
   "who": "narrator",
   "text": "Sáng hôm sau, chính chú chạy qua tìm tôi.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 87.651,
   "end": 89.821,
   "dur": 2.17
  },
  {
   "line": 44,
   "who": "narrator",
   "text": "Chiếc đồng hồ quả quýt cha để lại cho chú đã biến mất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 90.002,
   "end": 92.255,
   "dur": 2.254
  },
  {
   "line": 45,
   "who": "narrator",
   "text": "Lần này, chú gọi hai lính gác đi cùng tôi.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 92.436,
   "end": 94.634,
   "dur": 2.198
  },
  {
   "line": 46,
   "who": "narrator",
   "text": "Qua cửa kính nhà máy, chú thấy ông Bách nhặt chiếc đồng hồ của mình khỏi băng chuyền.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 94.814,
   "end": 98.313,
   "dur": 3.499
  },
  {
   "line": 47,
   "who": "narrator",
   "text": "Chú quay sang hai lính gác.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 98.494,
   "end": 99.68,
   "dur": 1.186
  },
  {
   "line": 48,
   "who": "narrator",
   "text": "Mở cửa kho.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 99.861,
   "end": 100.647,
   "dur": 0.786
  },
  {
   "line": 49,
   "who": "narrator",
   "text": "Lính gác mở cửa kho.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 101.047,
   "end": 102.187,
   "dur": 1.14
  },
  {
   "line": 50,
   "who": "narrator",
   "text": "Thị trưởng nhìn sang chồng thùng in tên tiệm ông Bách.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 102.368,
   "end": 104.346,
   "dur": 1.978
  },
  {
   "line": 51,
   "who": "narrator",
   "text": "Ủa, đây là mấy thùng sáng nay ông báo mất mà?",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 104.527,
   "end": 106.771,
   "dur": 2.244
  },
  {
   "line": 52,
   "who": "narrator",
   "text": "Ông Bách im luôn.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 106.951,
   "end": 107.761,
   "dur": 0.809
  },
  {
   "line": 53,
   "who": "narrator",
   "text": "Tôi mới hiểu.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 107.941,
   "end": 108.512,
   "dur": 0.571
  },
  {
   "line": 54,
   "who": "narrator",
   "text": "Cứ mỗi lần cả thị trấn mất đồ, ông lại giấu thêm vài thùng hàng của mình rồi đi báo mất.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 108.693,
   "end": 112.492,
   "dur": 3.799
  },
  {
   "line": 55,
   "who": "narrator",
   "text": "Ai mà nghi người than mất nhiều nhất chứ?",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 112.672,
   "end": 114.263,
   "dur": 1.591
  },
  {
   "line": 56,
   "who": "narrator",
   "text": "Sáng hôm sau, tôi lấy lại sợi dây chuyền.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 114.444,
   "end": 116.508,
   "dur": 2.064
  },
  {
   "line": 57,
   "who": "narrator",
   "text": "Tôi cất dây chuyền vào két.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 116.688,
   "end": 117.745,
   "dur": 1.056
  },
  {
   "line": 58,
   "who": "narrator",
   "text": "Vừa quay lưng, Bắp đã ôm nguyên cái két.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 117.926,
   "end": 119.897,
   "dur": 1.972
  },
  {
   "line": 59,
   "who": "narrator",
   "text": "Bắp.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 120.078,
   "end": 120.255,
   "dur": 0.177
  },
  {
   "line": 60,
   "who": "narrator",
   "text": "Nó đặt xuống liền.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 120.436,
   "end": 121.317,
   "dur": 0.881
  },
  {
   "line": 61,
   "who": "narrator",
   "text": "Tôi gõ nhẹ lên đầu Bắp một cái.",
   "source": "capcut",
   "voice": "BV075_streaming",
   "at": null,
   "start": 121.498,
   "end": 122.991,
   "dur": 1.494
  }
 ]
}